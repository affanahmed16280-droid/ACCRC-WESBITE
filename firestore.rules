rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null;
    }

    // Fest Global Settings & Launcher Toggles: Public read, Admin write
    match /fest_settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    // Fest Segments & Competitions: Public read, Admin write
    match /fest_segments/{segmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fest Schedules: Public read, Admin write
    match /fest_schedule/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fest Announcements & Match Results: Public read, Admin write
    match /fest_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fest Registrations & Teams:
    // Anyone can create a team registration.
    // Public read so teams can retrieve their own pass by ID.
    // Kept readable for legacy registrations created before the canonical
    // registrations collection was introduced.
    match /fest_registrations/{regId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Regular Club Events: Public read, Admin write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // News & Announcements: Public read, Admin write
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Achievements: Public read, Admin write
    match /achievements/{achievementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Membership, event, and fest registrations. Fest entries are public only
    // for participant lookup; administrative mutations still require sign-in.
    match /registrations/{regId} {
      allow create: if true;
      allow read: if isAdmin() || resource.data.type == 'fest';
      allow update, delete: if isAdmin();
    }

    // Leadership Applications (Executive, Prefect, Sub-Executive)
    match /applications/{appId} {
      allow create: if exists(/databases/$(database)/documents/config/portal) && (
        (request.resource.data.type == 'executive' &&
          get(/databases/$(database)/documents/config/portal).data.execOpen == true) ||
        (request.resource.data.type == 'prefect' &&
          get(/databases/$(database)/documents/config/portal).data.prefectOpen == true) ||
        (request.resource.data.type == 'sub-executive' &&
          get(/databases/$(database)/documents/config/portal).data.subExecOpen == true)
      );
      allow read, update, delete: if isAdmin();
    }

    // Portal Config: Public read, Admin write
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
