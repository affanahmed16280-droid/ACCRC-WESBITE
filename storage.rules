rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAdmin() {
      return request.auth != null;
    }

    // Team submissions: Maximum 50MB file size, require authentication
    match /fests/{festId}/teams/{teamId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // General assets
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
